<?xml version="1.0" ?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
  <Meta name="ExplicitAutoJoints">true</Meta>
  <External/>
  <Item class="ReplicatedStorage" referent="RBXReplicatedStorage">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="RBXCombatFolder">
      <Properties>
        <string name="Name">Combat</string>
      </Properties>
      <Item class="ModuleScript" referent="RBXModuleLoaderRef">
        <Properties>
          <string name="Name">ModuleLoader</string>
          <ProtectedString name="Source"></ProtectedString>
        </Properties>
      </Item>
      <Item class="Folder" referent="RBXHandlersFolder">
        <Properties>
          <string name="Name">Handlers</string>
        </Properties>
        <Item class="ModuleScript" referent="RBXBlockHandlerRef">
          <Properties>
            <string name="Name">BlockHandler</string>
            <ProtectedString name="Source"></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXDashHandlerRef">
          <Properties>
            <string name="Name">DashHandler</string>
            <ProtectedString name="Source"></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXPassiveHandlerRef">
          <Properties>
            <string name="Name">PassiveHandler</string>
            <ProtectedString name="Source"></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBXServerScriptService">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBXInitServer_V2Ref">
      <Properties>
        <string name="Name">InitServer_V2</string>
        <ProtectedString name="Source"></ProtectedString>
      </Properties>
      <Item class="Folder" referent="RBXInitHandlersFolder">
        <Properties>
          <string name="Name">handlers</string>
        </Properties>
        <Item class="ModuleScript" referent="RBXComboManagerRef">
          <Properties>
            <string name="Name">ComboManager</string>
            <ProtectedString name="Source"></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXM1HandlerRef">
          <Properties>
            <string name="Name">M1Handler</string>
            <ProtectedString name="Source"></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBXAerialM1HandlerRef">
          <Properties>
            <string name="Name">AerialM1Handler</string>
            <ProtectedString name="Source"></ProtectedString>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBXUptiltHandlerRef">
        <Properties>
          <string name="Name">UptiltHandler</string>
          <ProtectedString name="Source"></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBXAerialHandlerRef">
        <Properties>
          <string name="Name">AerialHandler</string>
          <ProtectedString name="Source"></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>
