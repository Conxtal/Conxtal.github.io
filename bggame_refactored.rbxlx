        Stamina = 1.0,           -- stamina pool multiplier
        StaminaRegen = 1.0,      -- stamina regen rate
        Health = 100,

        WalkSpeed = 16,          -- Roblox humanoid walkspeed
        JumpPower = 50,

        -- Posture (Sekiro-style guard system)
